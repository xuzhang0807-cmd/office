{
  "name": "office-portal",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "在线办公门户：模块化能力服务（docx/xlsx/pptx/pdf）+ 素材库 + muse2api AI 网关",
  "workspaces": [
    "shared",
    "docx",
    "xlsx",
    "pptx",
    "pdf",
    "portal",
    "portal/web"
  ],
  "scripts": {
    "start": "node scripts/stack.mjs",
    "start:portal": "node portal/src/index.js",
    "dev": "node scripts/dev.mjs",
    "build": "npm --workspace @office/web run build",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs tests/contract/*.test.mjs docx/test/*.test.mjs xlsx/test/*.test.mjs pptx/test/*.test.mjs pdf/test/*.test.mjs",
    "test:docx": "node --test docx/test/*.test.mjs",
    "test:xlsx": "node --test xlsx/test/*.test.mjs",
    "test:pptx": "node --test pptx/test/*.test.mjs",
    "test:pdf": "node --test pdf/test/*.test.mjs",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "check": "npm run lint && npm test",
    "deploy:blog": "node deploy/patch-blog.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
