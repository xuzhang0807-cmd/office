# Office Portal — 环境变量说明
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）

# ---- 门户 ----
OFFICE_PORT=32110
OFFICE_HOST=0.0.0.0
# 对外访问地址（用于文档内绝对链接、博客回跳，可留空）
OFFICE_PUBLIC_BASE=
# 博客地址，显示在顶栏「博客」按钮
OFFICE_BLOG_URL=https://blog.example.com
OFFICE_SITE_NAME=在线办公

# 数据目录（SQLite + 文件内容寻址存储）
OFFICE_DATA_DIR=./data

# 是否允许自助注册（首个注册账号自动成为管理员）
OFFICE_ALLOW_REGISTER=1
# 上传上限（MB）
OFFICE_MAX_UPLOAD_MB=25
OFFICE_MAX_JSON_MB=32
OFFICE_SESSION_DAYS=30

# ---- 能力服务地址 ----
# 本地直跑用 127.0.0.1；docker compose 里由 compose 覆盖成 http://docx:32201 等。
# 想把某个能力放到别的机器，只改这一行即可，门户无需重启代码。
OFFICE_DOCX_URL=http://127.0.0.1:32201
OFFICE_XLSX_URL=http://127.0.0.1:32202
OFFICE_PPTX_URL=http://127.0.0.1:32203
OFFICE_PDF_URL=http://127.0.0.1:32204

# 能力服务自身监听端口（单独跑该服务时生效）
OFFICE_DOCX_PORT=32201
OFFICE_XLSX_PORT=32202
OFFICE_PPTX_PORT=32203
OFFICE_PDF_PORT=32204

# 能力调用超时（秒）：普通操作 / 合并等重操作
OFFICE_SERVICE_TIMEOUT=60
OFFICE_SERVICE_HEAVY_TIMEOUT=180

# ---- muse2api 内置模型 ----
# 留空时自动读取同级 ../muse2api/.env 的 MUSE2API_KEY
OFFICE_MUSE_KEY=
OFFICE_MUSE_BASE=http://127.0.0.1:18610
# docker compose 内部访问地址（容器网络）
OFFICE_MUSE_BASE_DOCKER=http://muse2api:18610
OFFICE_MUSE_CHAT_MODEL=muse-spark
OFFICE_MUSE_IMAGE_MODEL=muse-image
OFFICE_MUSE_CHAT_TIMEOUT=180
OFFICE_MUSE_IMAGE_TIMEOUT=240

# ---- 每日 AI 配额（0=禁用，-1 表示不限制；admin 恒为不限制）----
OFFICE_QUOTA_USER_CHAT=0
OFFICE_QUOTA_USER_IMAGE=0
OFFICE_QUOTA_MEMBER_CHAT=60
OFFICE_QUOTA_MEMBER_IMAGE=6

# ---- PDF 中文字体 ----
# 留空自动探测系统字体。必须是 TrueType 轮廓；
# 不要指到 Noto CJK（CFF 轮廓会让 fontkit 的 CFFSubset 打挂进程）。
OFFICE_PDF_FONT=
OFFICE_PDF_FONT_CACHE=

# ---- Docker ----
# 门户对宿主暴露的端口
OFFICE_HOST_PORT=32110
IMAGE_TAG=latest
OFFICE_NETWORK=office_default
MUSE_NETWORK=muse2api_default
