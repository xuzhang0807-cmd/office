# Office Portal — 环境变量说明
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）

# 服务监听
OFFICE_PORT=32110
OFFICE_HOST=0.0.0.0
# 对外访问地址（用于文档内绝对链接、博客回跳，可留空）
OFFICE_PUBLIC_BASE=
# 博客地址，显示在顶栏「博客」按钮
OFFICE_BLOG_URL=https://blog.example.com
OFFICE_SITE_NAME=在线办公

# 数据目录（SQLite + 文件内容寻址存储）
OFFICE_DATA_DIR=./data

# 是否允许自助注册（首个注册账号自动成为管理员）
OFFICE_ALLOW_REGISTER=1
# 上传上限（MB）
OFFICE_MAX_UPLOAD_MB=25
OFFICE_MAX_JSON_MB=32
OFFICE_SESSION_DAYS=30

# ---- muse2api 内置模型 ----
# 留空时自动读取同级 ../muse2api/.env 的 MUSE2API_KEY
OFFICE_MUSE_KEY=
OFFICE_MUSE_BASE=http://127.0.0.1:18610
OFFICE_MUSE_CHAT_MODEL=muse-spark
OFFICE_MUSE_IMAGE_MODEL=muse-image
OFFICE_MUSE_CHAT_TIMEOUT=180
OFFICE_MUSE_IMAGE_TIMEOUT=240

# ---- 每日 AI 配额（0=禁用，-1 表示不限制；admin 恒为不限制）----
OFFICE_QUOTA_USER_CHAT=0
OFFICE_QUOTA_USER_IMAGE=0
OFFICE_QUOTA_MEMBER_CHAT=60
OFFICE_QUOTA_MEMBER_IMAGE=6

# PDF 中文字体（可选，留空自动探测系统字体）
OFFICE_PDF_FONT=
